# ===== SAP 連線(必填)=====
SAP_URL=https://your-sap-host:44300
SAP_USER=DEVELOPER
# 密碼請保留雙引號:密碼含 # 必須加引號,否則 # 之後會被當成註解截斷(導致 401,重試多次會鎖帳號)
SAP_PASSWORD="changeme"
SAP_CLIENT=100
SAP_LANGUAGE=EN

# ===== 安全設定 =====
# 系統角色:dev / qa / prod(prod 一律強制唯讀)
ABAP_MCP_SYSTEM_ROLE=dev
# 唯讀模式:true 時寫入工具不會註冊
ABAP_MCP_READONLY=false
# 可寫入的物件名稱前綴白名單(逗號分隔)
ABAP_MCP_ALLOWED_PREFIXES=Z,Y,$
# 可寫入/建立/執行物件所在的 package 白名單(逗號分隔,* 結尾為前綴比對)
ABAP_MCP_ALLOWED_PACKAGES=$TMP,Z*,Y*
# 讀取資料表內容(data_preview);false 時工具完全不註冊。開啟前請先閱讀 docs/SECURITY.md
ABAP_MCP_ALLOW_DATA_PREVIEW=false
# data_preview 可讀的表/view 白名單(逗號分隔,* 結尾為前綴比對);FROM / JOIN 的每張表都會檢查。
# 注意:不要輕易加入 Z* / Y*。AI 能寫入時,可以自建一個 Z 開頭的 CDS view 去 select 任意表(例如 USR02),
# 再用 data_preview 讀這個 view,白名單只看得到 view 名稱,擋不住背後的表。
ABAP_MCP_DATA_PREVIEW_TABLES=/DMO/*
# 內網開發系統自簽憑證時設為 true(請先閱讀 docs/SECURITY.md)
ABAP_MCP_ALLOW_SELF_SIGNED=false
# 寫入操作稽核紀錄(留空 = 停用)
ABAP_MCP_AUDIT_LOG=
# read_source 回傳行數上限
ABAP_MCP_MAX_SOURCE_LINES=5000
